# Production .env for smtp.verifycatch.com — copy to /opt/smtp-app/.env on the server
# and edit values marked TODO.

NODE_ENV="production"

# ── Database ────────────────────────────────────────────────
# Uses the existing Postgres instance but a NEW database, isolated from ev_db.
DATABASE_URL="postgresql://smtp_app:TODO_SET_STRONG_PASSWORD@127.0.0.1:5432/smtp_platform?schema=public"

# ── Redis ───────────────────────────────────────────────────
# Namespace via DB 1 so BullMQ queues don't collide with the api-gateway on DB 0.
REDIS_URL="redis://127.0.0.1:6379/1"

# ── Object storage ──────────────────────────────────────────
# Local filesystem — raw MIME + attachments land under /opt/smtp-app/storage/
STORAGE_DRIVER="fs"
STORAGE_LOCAL_PATH="/opt/smtp-app/storage"
# S3_* fields ignored when STORAGE_DRIVER=fs, but kept so config validation passes.
S3_ENDPOINT="http://localhost:9000"
S3_BUCKET_RAW="raw"
S3_BUCKET_ATTACHMENTS="attachments"
S3_REGION="us-east-1"
S3_FORCE_PATH_STYLE="true"

# ── Auth secrets ────────────────────────────────────────────
# Generate: openssl rand -hex 32
JWT_ACCESS_SECRET="TODO_openssl_rand_hex_32_replace_me_prod_access_secret"
JWT_REFRESH_SECRET="TODO_openssl_rand_hex_32_replace_me_prod_refresh_secret"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS="30"

# ── Ports + CORS ────────────────────────────────────────────
# API binds 127.0.0.1:4000 — nginx handles TLS + public :443.
API_PORT="4000"
CORS_ORIGIN="https://smtp.verifycatch.com"

# ── Mailer (Gmail relay for now) ────────────────────────────
# Uses the existing Gmail app password. Migrate to Brevo/SES for domain-preserving From later.
MAILER_RELAY_HOST="smtp.gmail.com"
MAILER_RELAY_PORT="587"
MAILER_RELAY_USER="TODO_your_gmail_address"
MAILER_RELAY_PASS="TODO_gmail_app_password"
MAILER_RELAY_SECURE="false"
MAILER_CONCURRENCY="5"

# ── Domain verification ─────────────────────────────────────
# In prod, DKIM must actually resolve via real DNS — DEV_SKIP_DNS_CHECK is rejected at boot.
PLATFORM_SPF_INCLUDE="spf.verifycatch.com"
DKIM_SELECTOR="smtp"
DEV_SKIP_DNS_CHECK="false"

# ── Webhooks worker ─────────────────────────────────────────
WEBHOOKS_CONCURRENCY="10"
WEBHOOKS_TIMEOUT_MS="10000"

# ── SMTP protocol services (Phase 2, not deployed yet) ──────
# These are read by smtp-in / smtp-out — leaving them commented until Phase 2 opens
# inbound TCP 2525 + 587 in the Security Group.
# SMTP_IN_HOST="smtp.verifycatch.com"
# SMTP_IN_PORT="2525"
# SMTP_OUT_HOST="smtp.verifycatch.com"
# SMTP_OUT_PORT="587"
