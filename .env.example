# Copy to .env for local development.

# Database
# Note: host port 5433 (not 5432) to avoid colliding with a native Postgres install.
DATABASE_URL="postgresql://smtp:smtp@localhost:5433/smtp?schema=public"

# Redis (used by BullMQ queues and rate limiter — wired up starting phase 2)
REDIS_URL="redis://localhost:6379"

# Object storage — MinIO in dev, real S3 in prod
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="smtpminio"
S3_SECRET_KEY="smtpminio123"
S3_BUCKET_RAW="raw-messages"
S3_BUCKET_ATTACHMENTS="attachments"
S3_REGION="us-east-1"
S3_FORCE_PATH_STYLE="true"

# Auth secrets — generate with `openssl rand -hex 32` before deploying
JWT_ACCESS_SECRET="dev-only-access-secret-please-replace-me-with-32-plus-chars"
JWT_REFRESH_SECRET="dev-only-refresh-secret-please-replace-me-with-32-plus-chars"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS="30"

# Ports
API_PORT="3001"
WEB_PORT="5173"
CORS_ORIGIN="http://localhost:5173"

NODE_ENV="development"

# ────────────────────────────────────────────────────────────
# Mailer routing — pick ONE mode (priority: RELAY > OUTBOUND_TARGET > MX)
# ────────────────────────────────────────────────────────────
#
# MODE A: dev sink — nothing leaves your machine, MailHog catches everything
MAILER_OUTBOUND_TARGET="localhost:1025"
#
# MODE B: smart-host relay — real inbox delivery via an authenticated upstream.
# Uncomment ONE of the following blocks and comment out MAILER_OUTBOUND_TARGET above.
#
# ── Gmail SMTP (500/day, 5-min setup, needs a Google account app password) ──
# MAILER_RELAY_HOST="smtp.gmail.com"
# MAILER_RELAY_PORT="587"
# MAILER_RELAY_USER="you@gmail.com"
# MAILER_RELAY_PASS="xxxx xxxx xxxx xxxx"   # app password, NOT your regular Gmail password
# MAILER_RELAY_SECURE="false"
#
# ── Brevo (300/day free) ──
# MAILER_RELAY_HOST="smtp-relay.brevo.com"
# MAILER_RELAY_PORT="587"
# MAILER_RELAY_USER="your-brevo-smtp-user"
# MAILER_RELAY_PASS="your-brevo-smtp-key"
# MAILER_RELAY_SECURE="false"
#
# ── Amazon SES (us-east-1) ──
# MAILER_RELAY_HOST="email-smtp.us-east-1.amazonaws.com"
# MAILER_RELAY_PORT="587"
# MAILER_RELAY_USER="AKIA..."
# MAILER_RELAY_PASS="ses-smtp-password"
# MAILER_RELAY_SECURE="false"
#
# ── Postmark (100/mo free) ──
# MAILER_RELAY_HOST="smtp.postmarkapp.com"
# MAILER_RELAY_PORT="587"
# MAILER_RELAY_USER="your-postmark-token"
# MAILER_RELAY_PASS="your-postmark-token"
# MAILER_RELAY_SECURE="false"
#
# MODE C: direct MX lookup — leave all MAILER_RELAY_* AND MAILER_OUTBOUND_TARGET unset.
# Only works from a VPS with port 25 unblocked + good IP reputation.

MAILER_CONCURRENCY="5"

# smtp-out — SMTP submission listener (customers point their SMTP clients here)
SMTP_OUT_HOST="localhost"
SMTP_OUT_PORT="587"

# Webhooks worker
WEBHOOKS_CONCURRENCY="10"
WEBHOOKS_TIMEOUT_MS="10000"

# What customers put in their SPF include record for us (shown in the DNS instructions).
PLATFORM_SPF_INCLUDE="spf.smtp-platform.local"
DKIM_SELECTOR="smtp"

# DEV ONLY. When "true", domain verification skips DNS checks and marks domains VERIFIED
# unconditionally. Rejected at boot when NODE_ENV=production.
DEV_SKIP_DNS_CHECK="false"
